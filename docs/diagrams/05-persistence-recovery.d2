# GoVecDB v1 — persistence and recovery
#
# Three independent clocks, differing by orders of magnitude:
#   WAL append     every write, under writeMu, into a 64 KiB bufio buffer
#   WAL fsync      per policy — SyncAlways (default) every append,
#                  SyncInterval every 50 ms; bounds how much you can lose
#   Snapshot       minutes (~12 ms floor: two fsyncs) — bounds recovery time
#                  and log size
#
# The WAL is read exactly ONCE in the life of a process: at Open.
# Snapshots are written FROM RAM. You never re-read the log to persist.
#
# Every name, size and number here is checked against internal/wal,
# internal/snapshot, codec.go, recovery.go, db.go and docs/DURABILITY.md.

vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 40
  }
}


# Black canvas. Theme 200 makes default label/markdown text light;
# every explicit fill below is a dark surface chosen to keep its hue.
style.fill: "#000000"

direction: down

classes: {
  group: {
    style.fill: "#0C0C14"
    style.stroke: "#44445A"
    style.stroke-width: 2
  }
  ram: {
    style.fill: "#0D2137"
    style.stroke: "#4FC3F7"
    style.stroke-width: 2
  }
  wal: {
    style.fill: "#33240E"
    style.stroke: "#FFB74D"
    style.stroke-width: 2
  }
  disk: {
    shape: cylinder
    style.fill: "#0E2A16"
    style.stroke: "#66BB6A"
    style.stroke-width: 2
  }
  bad: {
    style.fill: "#3B1215"
    style.stroke: "#EF5350"
    style.stroke-width: 2
  }
  good: {
    style.fill: "#0E2A16"
    style.stroke: "#66BB6A"
    style.stroke-width: 2
  }
  note: {
    shape: text
    style.font-size: 13
    style.italic: true
  }
}

# Field widths are the frozen wire layout (TestLayoutIsFrozen in each
# package), so they are spelled out rather than summarised.
record: WAL record — 17 B header + payload {
  shape: sql_table

  crc32c: "uint32  — covers type, seq, len AND payload"
  type: "uint8   — PUT=1 | DELETE=2 | CHECKPOINT=3 (reserved, never written); 0 invalid"
  seq: "uint64  — strictly increasing; gaps ok, repeats refused"
  len: "uint32  — refused vs file size + MaxRecordBytes before any alloc"
  payload: "[]byte  — opaque to wal; PUT = ver | idLen | id | dim | float32s | metadata"
}

header: Segment file header — 8 B {
  shape: sql_table

  magic: "4 B    — 'GVWL', catches a wrong file"
  version: "uint16 — present from the first byte written"
  reserved: "uint16 — zero"
}

fmt_note: |md
  ### Why `[len][data]` is not enough

  **crc32c over the header too** — a corrupt *length* is the
  dangerous one: it turns a bad read into an arbitrary allocation.
  Nothing is allocated on a length that has not been bounded.

  **Type 0 is invalid** — zero-filled space never decodes as a record.

  **version** — a format without one can never be migrated.

  **seq** — tells replay where the snapshot ends and the tail begins.
| {
  class: note
}

runtime: Running system {
  class: group

  ram_state: In-memory state {
    class: ram
    g: HNSW graph
    m: store.Map metadata
  }

  wal_active: WAL writer {
    class: wal
    buf: 64 KiB bufio buffer (user space)
    body: active segment wal-000017.log
  }

  # writeMu spans append and apply; applyMu is held only for the apply, so a
  # search never waits on a writer's fsync.
  wal_active -> ram_state: "append FIRST, then apply (writeMu; applyMu for the apply only)" {
    style.stroke: "#FF6B6B"
    style.stroke-width: 3
  }
}

derived_note: |md
  **The graph is derived state, never the source of truth.**
  It can always be rebuilt from snapshot + log. That is what
  makes the write ordering non-negotiable.

  **Fail closed:** the first WAL error makes the DB permanently
  `ErrReadOnly` (a `DurabilityFailure` event); reads keep working.

  **Under SyncInterval / SyncNever** an acknowledged write may still
  sit in the user-space buffer — a *process* crash can lose it too.
| {
  class: note
}

checkpoint: Snapshot cycle — DB.Snapshot (snapMu) {
  class: group

  c1: 1 · Take writeMu, seq N = log.LastSeq() {
    class: ram
    body: skipped if nothing logged or compacted since the last one
  }
  c2: 2 · Serialize FROM RAM {
    class: ram
    body: |md
      payload = `GVDB` header · **graph section** (`hnsw` `WriteTo`)
      · **metadata section** (`store.Map`) — self-delimiting,
      sharing one `bufio.Reader` on load
    |
  }
  c3: 3 · Write snap-*.tmp {
    class: disk
  }
  c4: 4 · fsync → rename → fsync the directory {
    class: disk
    body: rename is the commit; the dir fsync makes the name survive. writeMu released.
  }
  c5: 5 · Prune — keep 2 {
    class: disk
    body: only after the new one is durable
  }
  c6: 6 · Verify the OLDEST retained, then wal.Truncate(oldest.Seq+1) {
    class: wal
    body: verify fails → TruncationSkipped, log kept
  }

  c1 -> c2 -> c3 -> c4 -> c5 -> c6
}

snapshot_choice: The decision in the snapshot — settled {
  style.fill: "#332B0D"
  style.stroke: "#FFD54F"
  style.stroke-width: 3

  body: |md
    ### Serialize the graph, not just the vectors

    Measured at **1M × 128**: verifying and decoding the
    graph is **~0.36 s**; re-inserting every vector is
    **~506 s** on one core — about **1,400×**.

    The price: the codec freezes `node` on disk, so changing it
    is a format migration (`TestCodecLayoutIsFrozen`).
  |
}

snap_fmt: Snapshot file — 16 B header + payload + 12 B trailer {
  shape: sql_table

  magic: "4 B    — 'GVSS'"
  version: "uint16 · reserved uint16"
  seq: "uint64 — checksummed; wins over the file name"
  payload: "streamed — gigabytes, never held in memory"
  crc32c: "uint32 — trailer: covers header + payload"
  length: "uint64 — cross-checked against the file size"
}

storage: Disk layout {
  class: group

  seg_old: wal/wal-000015.log\nwal/wal-000016.log {
    class: disk
    style.multiple: true
    style.opacity: 0.7
  }
  snap: "snapshots/snap-<20-digit seq>.snap\n(newest + one older)" {
    class: disk
    style.multiple: true
  }
  seg_new: wal/wal-000017.log\n(active) {
    class: disk
  }
}

truncated_note: |md
  A segment is deletable once the **next** segment's first seq,
  read through the checksummed reader, is ≤ the oldest retained
  snapshot's seq + 1. Never the newest segment. Truncating
  against the *newest* snapshot would strand the older copy.
| {
  class: note
}

recovery: Recovery — Open, the only time the WAL is read {
  class: group

  r0: 0 · flock the directory {
    class: ram
    body: exclusive for a writer, shared for WithReadOnly
  }
  r1: 1 · snapshot.Load — newest that verifies end to end {
    class: disk
    body: corrupt → SnapshotRejected, try the older one; none → empty DB. A decode error is fatal, not a fallback.
  }
  r2: 2 · Install graph + metadata at seq N {
    class: ram
    body: dimension, metric or M differ → refused
  }
  r3: 3 · wal.Replay: first seq > N+1? {
    shape: diamond
    class: bad
  }
  r3x: ErrCorrupt {
    class: bad
    body: the log no longer reaches back — restore the snapshots
  }
  r4: 4 · Apply records with seq > N {
    class: wal
    body: runs of PUTs via InsertBatch, flushed at every DELETE
  }
  r5: 5 · Record fails its CRC? {
    shape: diamond
    class: bad
  }
  r6: 6 · Tear ends the SEGMENT, not the replay {
    class: wal
    body: |md
      Logical truncation (bytes stay on disk), a `TornLog`
      event, then on to the next segment — a twice-crashed
      log has a tear in the middle, and that is normal.
    |
  }
  r7: 7 · wal.Open — always a NEW segment {
    shape: circle
    style.fill: "#1B4D2E"
    style.stroke: "#66BB6A"
  }

  r0 -> r1 -> r2 -> r3
  r3 -> r3x: yes
  r3 -> r4: no
  r4 -> r5
  r5 -> r6: yes
  r6 -> r4: next segment
  r5 -> r7: "no, end of log"
}

open_note: |md
  **Why a new segment:** appending after a torn tail would bury
  good records behind a permanent stopping point. The one reuse is
  a newest segment that is *exactly* an 8 B header. `FirstSeq` =
  max(N+1, replay's NextSeq).
| {
  class: note
}

test_note: |md
  ### Tested by actually killing the process

  `TestCrashMidWriteKeepsEveryAcknowledgedRecord` spawns a child,
  `SIGKILL`s it mid-write, reopens, and asserts every acknowledged
  record survived. `TestAnotherProcessIsRefused` does the same to
  prove the kernel drops a dead holder's flock.
| {
  class: note
}

rotation: Segment rotation — at 64 MiB {
  class: good

  body: |md
    **fsync the old segment before creating the new one**, whatever
    the sync policy — otherwise a crash leaves a hole in the *middle*
    of the log, the one shape recovery cannot repair.

    **fsync the directory** on every new segment, or a crash can take
    a fresh segment — and `SyncAlways` writes inside it — away.

    `MaxSegmentBytes` is a truncation granularity, not a size cap. ~9 ms
    per rotation amortizes to **0.29 µs/record**. Segments sort
    **numerically**, never lexically.
  |
}

header -> record: "file starts with, then N records"
runtime.wal_active -> storage.seg_new: appends land here
runtime.wal_active -> rotation: "segment full" {
  style.stroke-dash: 3
}
runtime.ram_state -> checkpoint.c1: "timer or Snapshot()" {
  style.stroke: "#CE93D8"
  style.stroke-width: 2
}
checkpoint.c4 -> storage.snap
checkpoint.c6 -> storage.seg_old: delete {
  style.stroke-dash: 3
}
storage.snap -> recovery.r1: on Open {
  style.stroke: "#4FC3F7"
  style.stroke-width: 2
}
storage.seg_new -> recovery.r3: every remaining segment {
  style.stroke: "#4FC3F7"
  style.stroke-width: 2
}

# --- annotations, drawn faint so they never compete with the flow ---
record -> fmt_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
runtime -> derived_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
checkpoint -> snapshot_choice: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
storage.snap -> snap_fmt: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
storage -> truncated_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
recovery.r7 -> open_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
recovery -> test_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
