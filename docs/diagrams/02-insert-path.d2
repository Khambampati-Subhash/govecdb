# GoVecDB v1 — insert path, end to end
#
# The ordering constraint is the whole point: the WAL append is the COMMIT
# POINT. Apply-to-graph happens after, and is safe to redo on replay. Reverse
# these two and a crash between them means you acked a write that no longer
# exists.

vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 40
  }
}


# Black canvas. Theme 200 makes default label/markdown text light;
# every explicit fill below is a dark surface chosen to keep its hue.
style.fill: "#000000"

direction: down

classes: {
  step: {
    style.fill: "#0D2137"
    style.stroke: "#4FC3F7"
    style.stroke-width: 2
  }
  critical: {
    style.fill: "#3B1215"
    style.stroke: "#FF6B6B"
    style.stroke-width: 3
  }
  wal: {
    style.fill: "#33240E"
    style.stroke: "#FFB74D"
    style.stroke-width: 2
  }
  graph: {
    style.fill: "#191B33"
    style.stroke: "#9FA8DA"
  }
  disk: {
    shape: cylinder
    style.fill: "#0E2A16"
    style.stroke: "#66BB6A"
  }
  note: {
    shape: text
    style.font-size: 13
    style.italic: true
  }
}

start: "Insert(ns, id, vec, meta)" {
  shape: circle
  style.fill: "#3A2B52"
  style.stroke: "#B39DDB"
}

s1: 1 · Validate {
  class: step
  body: |md
    dimension · non-empty · ≤ 4096
    reject NaN / ±Inf
  |
}

s2: 2 · Resolve namespace {
  class: step
  body: |md
    registry lookup; create or
    load the collection if cold
  |
}

s3: 3 · Assign sequence number {
  class: step
  body: |md
    monotonic LSN — orders the WAL and
    marks where a snapshot ends
  |
}

wal_block: 4 · WAL APPEND — the commit point {
  class: critical

  encode: Encode record {
    class: wal
    fmt: |md
      `[crc32][type=INSERT][seq][len][payload]`
      payload = id + dim + float32s + meta
    |
  }

  append: Append to buffer {
    class: wal
  }

  fsync: fsync policy gate {
    class: wal
    body: |md
      **always** — safe, ~1–10 ms/write on consumer NVMe
      **interval** — group commit, default ~50 ms
      **never** — tests and benchmarks only
    |
  }

  encode -> append -> fsync
}

durable_note: |md
  **Only after fsync returns is the write durable.**
  With `interval`, you may lose up to that window on
  power loss — that is a documented product decision,
  not an accident. Redis ships the same tradeoff.
| {
  class: note
}

s5: 5 · Apply to in-memory graph {
  class: critical

  copy: "prepare(v) — copy + normalize" {
    class: graph
    body: |md
      Copies so the graph never aliases a
      caller buffer. Normalizes for Cosine,
      collapsing it to `1 - dot(a,b)`.
    |
  }

  upsert: "5a · Is this id already live? — the upsert branch" {
    class: graph
    style.stroke: "#FFD54F"
    style.stroke-width: 2

    same: "ids[id] hit, same vector → return nil" {
      style.fill: "#332B0D"
      style.stroke: "#FFD54F"
      body: |md
        `slices.Equal` against the **stored** form.
        No tombstone, no slot, no edge touched.

        This is the WAL-replay path: recovery re-applies
        records the graph already holds, and if that cost
        a slot every restart would inflate the graph with
        tombstones for vectors that never changed.
        **332 ns**, against 776 µs for a real replacement.
      |
    }

    kill: "ids[id] hit, new vector → tombstone the old slot" {
      style.fill: "#3B1215"
      style.stroke: "#FF6B6B"
      style.stroke-width: 2
      body: |md
        1. `delete(ids, id)` — the **binding** goes
        2. `node.deleted = true` — the **slot** stays,
           keeping its index and every edge it has
        3. `numDeleted++`
        4. was this slot the entry? → `reelectEntry()`,
           or the descent below starts from a corpse

        Inside `Insert`'s own write lock, never by calling
        `Delete` — that would open a window where the id
        belongs to nobody, and a reader would observe an
        update as a **disappearance**.
      |
    }

    same -> kill: "vector differs" {
      style.stroke: "#FFD54F"
    }
  }

  why_new_slot: |md
    **Why not just overwrite `node.vector` in place?**

    The slot's index is referenced by neighbor lists all over
    the graph, and those edges were chosen for the OLD vector —
    they claim "these two are close" about a pair that no longer
    is. Searches would keep being routed in from a region the
    vector has left.

    Repairing them is not available either: pruning makes edges
    asymmetric, so a node's own neighbor list is *not* the list
    of nodes pointing at it. Finding every inbound edge means
    scanning the whole graph, **O(N·M) per update**.

    A fresh slot is correct by construction. It costs one dead
    slot — the same debt `Delete` takes on, paid to the same
    compaction pass.
  | {
    class: note
  }

  lvl: "randomLevel() — for a brand-new slot" {
    class: graph
    body: |md
      `int(-log(rand) * ml)`, `ml = 1/ln(M)`
      Seeded → replay reproduces the graph

      A replacement draws a **fresh** level; it does
      not inherit the height of the slot it replaced.
    |
  }

  descend: Greedy descend maxLevel → level+1 {
    class: graph
    body: ef=1, just to find a good entry point
  }

  connect: For each layer level → 0 {
    class: graph
    body: |md
      1. `searchLayer(vec, cur, EfConstruction, lc)`
      2. `selectNeighbors(w, maxConn(lc))` — alpha-pruned
      3. `connect(new, nb)` **and** `connect(nb, new)`
      4. `pruneConnections(nb, lc)` — trim to cap
      5. seed next layer with the closest hit
    |
  }

  promote: Promote to entry point {
    class: graph
    body: if level > maxLevel
  }

  copy -> upsert.same: "id already live"
  copy -> lvl: "new id — branch skipped" {
    style.stroke-dash: 3
  }
  upsert.kill -> lvl: "append a new slot at len(nodes)"
  lvl -> descend -> connect -> promote

  upsert -> why_new_slot: {
    style.stroke-dash: 4
    style.opacity: 0.7
    style.stroke: "#6E6E6E"
  }
}

s6: 6 · Ack client {
  shape: circle
  style.fill: "#1B4D2E"
  style.stroke: "#66BB6A"
}

wal_disk: WAL segment on disk {
  class: disk
  style.multiple: true
}

crash: Crash here? {
  shape: diamond
  style.fill: "#4A1418"
  style.stroke: "#EF5350"
}

crash_note: |md
  **Crash after step 4, before step 6** → the record is on
  disk. Replay re-applies it. The client never got an ack,
  so a retry is idempotent: PUT is an upsert, and re-applying
  a vector the graph already holds changes nothing.

  **Crash before step 4 completes** → torn tail record. CRC
  fails on recovery, the log truncates there, the write
  simply never happened. Both outcomes are consistent.
| {
  class: note
}

start -> s1 -> s2 -> s3 -> wal_block.encode

wal_block.fsync -> wal_disk: durable {
  style.stroke: "#FFB74D"
  style.stroke-width: 3
}

wal_block.fsync -> s5.copy: "ONLY NOW apply" {
  style.stroke: "#FF6B6B"
  style.stroke-width: 3
  style.bold: true
}

s5.promote -> s6

s5.upsert.same -> s6: "unchanged → return, graph untouched" {
  style.stroke: "#FFD54F"
  style.stroke-dash: 3
}

wal_block -> crash: {
  style.stroke-dash: 3
  style.opacity: 0.75
}
crash -> crash_note: {
  style.stroke-dash: 3
  style.opacity: 0.75
}

# --- annotations, drawn faint so they never compete with the flow ---
wal_block -> durable_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
