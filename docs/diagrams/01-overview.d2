# GoVecDB — end-to-end architecture of one govecdb.DB
#
# The load-bearing distinction in this diagram is the RAM / disk boundary.
# Vectors, graph and metadata are all RAM-resident because HNSW computes a
# distance at EVERY hop of traversal and the filter runs once per candidate;
# a disk read at either would turn one search into hundreds of seeks. Search
# does no disk I/O at all. Disk carries durability only: the log and the
# snapshots it is truncated against.
#
# The second distinction is the locks. Readers never take writeMu, which is
# held across the fsync, so a slow disk stalls writers and never searches.

vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 40
  }
}


# Black canvas. Theme 200 makes default label/markdown text light;
# every explicit fill below is a dark surface chosen to keep its hue.
style.fill: "#000000"

direction: down

classes: {
  group: {
    style.fill: "#0C0C14"
    style.stroke: "#44445A"
    style.stroke-width: 2
  }
  api: {
    style.fill: "#241B33"
    style.stroke: "#B39DDB"
    style.stroke-width: 2
  }
  ram: {
    style.fill: "#0D2137"
    style.stroke: "#4FC3F7"
    style.stroke-width: 2
  }
  wal: {
    style.fill: "#33240E"
    style.stroke: "#FFB74D"
    style.stroke-width: 2
  }
  critical: {
    style.fill: "#3B1215"
    style.stroke: "#FF6B6B"
    style.stroke-width: 2
  }
  disk: {
    shape: cylinder
    style.fill: "#0E2A16"
    style.stroke: "#66BB6A"
    style.stroke-width: 2
  }
  bg: {
    shape: hexagon
    style.fill: "#2A1233"
    style.stroke: "#CE93D8"
  }
  note: {
    shape: text
    style.font-size: 13
    style.italic: true
  }
}

client: Caller supplies embeddings {
  shape: person
  style.fill: "#1C1C1C"
}

embed_note: |md
  **Out of scope: GoVecDB never generates embeddings.**
  Running a model in-process means CGO and a model
  runtime — the end of "pure Go, zero dependencies,
  embeddable". Callers bring their own vectors.
| {
  class: note
}

# Drawn faint and dashed because the DB does not know it exists: collections,
# REST and the daemon import the root package, never the other way round.
service: "service/ · httpapi/ · cmd/govecdbd — separate packages ABOVE the DB" {
  class: group
  style.stroke-dash: 4
  style.opacity: 0.75

  explain: |md
    `service.Manager`: one DB per collection directory.
    REST over it, stdlib only. Optional; the root
    package and `internal/` never import these.
  |
}

api: Public API — db.go / enumerate.go / options.go {
  class: api

  open: "Open(dir, opts...) — restore, then open the log"
  add: "Add / AddBatch(Vector{ID, Values, Metadata}) — upsert"
  del: Delete(id)
  search: "Search(SearchRequest{Query, K, Ef, Filter})"
  read: "Get / GetBatch / Scan / Range"
  admin: "Snapshot / Compact / Sync / Stats / Close"
}

validate: validate.go — the security boundary {
  class: critical

  checks: |md
    - `len(Values) == Dimension` (≤ 65,536) → ErrInvalidVector
    - every value finite — one NaN compares false against
      everything and poisons the ordering; float metadata too
    - id non-empty UTF-8, ≤ 512 B; metadata a closed set of
      string / bool / int64 / float64, ≤ 256 keys
    - `K` ≤ 10,000; `Ef == 0` means "choose it"; Filter
      validated once, never per node
  |
}

db: govecdb.DB — one directory, in RAM {
  class: group

  locks: The DB's locks (db.go, above type DB) {
    class: critical

    explain: |md
      - **writeMu** — writers, across append *and* apply, so
        apply order = log order. Snapshot, Sync, Close take
        it; Compact only for its swap. **No reader ever does.**
      - **applyMu** — exclusive per apply only (batches in
        groups of `applyGroup` = max(64, 4 × workers));
        shared by readers so no one sees (v2, md1)
      - **snapMu** — snapshot vs snapshot and Close;
        **compactMu** the same for Compact
    |
  }

  wal_writer: "WAL writer — internal/wal" {
    class: wal

    explain: |md
      Sync policy zero value **SyncAlways** (fsync per append).
      SyncInterval (50 ms) / SyncNever leave records in a
      64 KiB user-space buffer. First failure is sticky →
      DB is permanently `ErrReadOnly`; reads keep working.
    |
  }

  graph: "HNSW index — internal/hnsw (own RWMutex)" {
    class: ram

    nodes: "nodes — vector, per-level neighbor slots, tombstone"
    ids: "ids — id → slot, live only"
    entry: entry point + maxLevel
    scratch: "pooled searchState — 1 alloc/op, filtered too"
  }

  store: "Metadata — internal/store (store.Map)" {
    class: ram

    explain: |md
      id → metadata, keys and strings interned.
      Filter evaluated **inside** the traversal,
      0 allocs per candidate. Persisted only via
      WAL records and the snapshot's 2nd section.
    |
  }
}

# The container is a plain group: a hexagon container puts its own label
# underneath its children. Only the leaf workers are hexagons.
background: Background goroutines {
  class: group

  snapshotter: "snapshotLoop — WithSnapshotInterval\n(library default off; daemon 10m)" {
    class: bg
  }
  truncator: "Prune (keep 2) + truncate the log" {
    class: bg
  }
  calibrator: "calibrationLoop — when live count\ndoubles or halves (≥ 1,000)" {
    class: bg
  }
}

storage: "Disk — dir is 0700, flock'd (internal/dirlock)" {
  class: group

  wal_files: "wal/wal-000001.log …\n8 B header · 17 B record header\n64 MiB segments" {
    class: disk
    style.multiple: true
  }
  snap: "snapshots/snap-<20-digit seq>.snap\ngraph + metadata, crc32c trailer" {
    class: disk
    style.multiple: true
  }
}

ram_note: |md
  ### Everything in the DB box is RAM

  Vectors are `float32`: 512 dims × 4 B = **2 KiB per vector**,
  so 1M vectors ≈ **2 GiB** before graph and metadata.
  Nothing here is paged from disk; a snapshot is a
  copy of it, never a cache it reads through.
| {
  class: note
}

client -> api.add: vectors + metadata
client -> api.search: query vector
client -> service: "or over HTTP" {
  style.stroke-dash: 4
  style.opacity: 0.7
}
service -> api: "uses the public API only" {
  style.stroke-dash: 4
  style.opacity: 0.7
}

api.add -> validate
api.del -> validate
api.search -> validate

# --- the write ordering that makes durability work ---
validate -> db.locks: "writes: take writeMu"
db.locks -> db.wal_writer: "1. append"
db.wal_writer -> storage.wal_files: "fsync per policy\n(SyncAlways: commit point)" {
  style.stroke: "#FFB74D"
  style.stroke-width: 3
}
db.wal_writer -> db.graph: "2. then apply under applyMu" {
  style.stroke: "#FF6B6B"
  style.stroke-width: 3
  style.bold: true
}
db.wal_writer -> db.store: "2. same hold"

# --- the read path never touches disk ---
validate -> db.graph: "Search: applyMu shared,\nno disk I/O" {
  style.stroke: "#4FC3F7"
  style.stroke-width: 2
}
db.graph -> db.store: "admits(id) per candidate;\nmetadata for the top k"

# --- background persistence ---
background.snapshotter -> db.graph: "serialize under writeMu —\nwriters wait, searches don't" {
  style.stroke: "#CE93D8"
  style.stroke-width: 2
}
background.snapshotter -> storage.snap: "temp → fsync → rename → fsync dir"
background.snapshotter -> background.truncator: "snapshot durable"
background.truncator -> storage.wal_files: "Verify OLDEST retained, then drop\nsegments wholly ≤ its seq" {
  style.stroke-dash: 3
}
background.calibrator -> db.graph: "efScale for Ef == 0\n(leave-one-out sample)" {
  style.stroke-dash: 3
}

# --- recovery: the graph is derived state, the log is the truth ---
storage.snap -> api.open: "Open: newest snapshot that verifies,\nthen replay the log past its seq;\nErrCorrupt if the log no longer reaches back" {
  style.stroke: "#66BB6A"
  style.stroke-dash: 4
}

# --- annotations, drawn faint so they never compete with the flow ---
client -> embed_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
db -> ram_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
