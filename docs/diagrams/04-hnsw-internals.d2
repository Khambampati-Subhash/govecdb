# GoVecDB v1 — what the HNSW index actually stores
#
# The layered graph, the anatomy of a node, and where the bytes go.
#
# Two things are deliberately NOT on Graph. Traversal scratch lives in a pooled
# searchState, which is what makes Search a reader rather than a writer. And a
# removed vector is not removed: the slot stays, flagged, because slots are
# addressed by index and because a node is a bridge. Both deletes and updates
# leave those slots behind — see the lifecycle panel.
#
# Field lists mirror graph.go, node.go and state.go exactly; a field added
# there and missing here is how this diagram went stale the first time.

vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 40
  }
}


# Black canvas. Theme 200 makes default label/markdown text light;
# every explicit fill below is a dark surface chosen to keep its hue.
style.fill: "#000000"

direction: down

classes: {
  group: {
    style.fill: "#0C0C14"
    style.stroke: "#44445A"
    style.stroke-width: 2
  }
  node: {
    shape: circle
    style.fill: "#12385C"
    style.stroke: "#64B5F6"
  }
  entry: {
    shape: circle
    style.fill: "#4A1418"
    style.stroke: "#EF5350"
    style.stroke-width: 3
  }
  layer: {
    style.fill: "#161616"
    style.stroke: "#6E6E6E"
  }
  struct: {
    style.fill: "#191B33"
    style.stroke: "#9FA8DA"
    style.stroke-width: 2
  }
  note: {
    shape: text
    style.font-size: 13
    style.italic: true
  }
}

graph_struct: "Graph — internal/hnsw/graph.go" {
  shape: sql_table

  mu: "sync.RWMutex — Search reads, Insert/Delete write"
  cfg: Config
  dist: "DistanceFunc — chosen once, never branched on"
  mMax: "int — neighbor cap, layers > 0 (= M)"
  mMax0: "int — neighbor cap, layer 0 (= 2·M)"
  ml: "float64 — 1/ln(M), level decay"
  alpha: "float32 — pruning relaxation, default 1.0"
  rng: "*rand.Rand — seeded, reproducible"
  normalized: "bool — stored vectors are unit length (Cosine)"
  nodes: "[]*node — slots, append-only; indexes never shift"
  ids: "map[string]int — LIVE external id → slot"
  entry: "int — entry point, -1 when empty"
  maxLevel: int
  numDeleted: "int — tombstoned slots; the compaction signal"
  writes: "uint64 — mutation count, re-checked at Compact's swap"
  locks: "*nodeLocks — 4,096 striped mutexes (32 KiB), batches only"
  pool: "sync.Pool — hands out per-traversal searchState"
  efScale: "atomic.Uint64 — Calibrate's ef factor, not serialized"
}

# No explicit fill: a sql_table takes its BODY colour from `style.stroke` and
# only its header from `style.fill`, so styling it the way every other shape in
# these diagrams is styled produces bright rows with light text on them. The
# green dashed edge from Graph carries the distinction instead.
state_struct: "searchState — internal/hnsw/state.go" {
  shape: sql_table

  visited: "visitedList — generation stamps"
  cands: "[]candidate — min-heap: the frontier"
  results: "[]candidate — max-heap: best ef so far"
  found: "[]candidate — searchLayer's sorted output"
  rejected: "[]candidate — selectNeighbors' backfill"
  pruneBuf: "[]candidate — pruneConnections' scratch"
  selected: "[]int — insert's chosen neighbors, this layer"
  queryBuf: "[]float32 — normalized copy of the query"
  nbrBuf: "[]int — a neighbor list copied out under its lock"
  fresh: "[]int — one expansion's unvisited neighbors (prefetch)"
  sink: "float32 — keeps touchLines' loads alive"
  locks: "*nodeLocks — non-nil only in a batch worker"
  hide: "int — 1+slot Calibrate hides, 0 = none"
}

node_struct: "node — internal/hnsw/node.go" {
  shape: sql_table

  id: "string — caller's external id"
  vector: "[]float32 — graph-owned copy, normalized for Cosine"
  neighbors: "[][]int — neighbors[l] = slots on layer l"
  deleted: "bool — tombstone: dead as an answer, alive as a route"
  linking: "atomic.Bool — edges still being built in a batch; others step around it"
}

hierarchy: The layered graph {
  class: group

  # grid-columns, not `direction: right` — nested direction is a TALA-only
  # feature; dagre and ELK both ignore it. Grids are engine-independent and
  # still draw intra-container edges.
  l2: Layer 2 — sparse, long jumps {
    class: layer
    grid-columns: 2
    grid-gap: 90
    a2: A {
      class: entry
    }
    d2n: D {
      class: node
    }
    a2 -- d2n
  }

  l1: Layer 1 — medium hops {
    class: layer
    grid-columns: 3
    grid-gap: 70
    a1: A {
      class: node
    }
    c1: C {
      class: node
    }
    d1: D {
      class: node
    }
    a1 -- c1
    c1 -- d1
  }

  l0: Layer 0 — EVERY vector lives here {
    class: layer
    grid-columns: 5
    grid-gap: 50
    a0: A {
      class: node
    }
    b0: B {
      class: node
    }
    c0: C {
      class: node
    }
    d0: D {
      class: node
    }
    e0: E {
      class: node
    }
    a0 -- b0
    b0 -- c0
    c0 -- d0
    d0 -- e0
    a0 -- c0
  }

  l2 -> l1: descend {
    style.stroke: "#EF5350"
    style.stroke-width: 2
  }
  l1 -> l0: descend {
    style.stroke: "#EF5350"
    style.stroke-width: 2
  }
}

level_note: |md
  ### How a node picks its top layer

  `randomLevel() = int(-log(rand()) * ml)`, `ml = 1/ln(M)`

  Exponentially decaying: most nodes stop at layer 0, a few
  reach high. That is what makes the top sparse and the
  descent cheap. The RNG is **seeded**, so the *serial* path
  replaying the same inserts in the same order rebuilds an
  identical graph — which is what makes Compact testable by
  equality. `InsertBatch` links on several workers and is not
  deterministic: `WithInsertWorkers(1)` + `WithSeed` for that.
| {
  class: note
}

selection: Neighbor selection — the recall lever {
  style.fill: "#332B0D"
  style.stroke: "#FFD54F"
  style.stroke-width: 2

  body: |md
    ### Not "keep the M closest"

    Keeping the M nearest produces edges that all point into the
    same cluster, and searches strand in local minima.

    Instead, drop candidate `c` when it already sits closer to an
    already-chosen neighbor `s` than to the node itself — you
    could reach `c` by hopping through `s`, so that edge buys
    nothing:

    `alpha * d(c,s) <= d(c,base)  →  reject c`

    **alpha = 1.0** — classic HNSW heuristic, and the **default**.
    **alpha > 1.0** rejects *less*: more near candidates survive and,
    arriving nearest-first, take the slots long-range edges needed.
    At 62.5K × 512 in 1,024 tight clusters, alpha 1.2 never passed
    recall 0.954 at any ef; 1.0 reached 0.95 at ef=10. Do not
    "restore" the DiskANN value.

    Rejected candidates are **backfilled** if the list comes up
    short — a node with too few edges is a dead end during search.
  |
}

lifecycle: A slot outlives its vector — delete AND update {
  style.fill: "#3B1215"
  style.stroke: "#FF6B6B"
  style.stroke-width: 2

  body: |md
    ### `Delete(id)` — a tombstone, never a removal

    `delete(ids, id)` · `deleted = true` · `numDeleted++` ·
    re-elect the entry if this slot *was* the entry.

    The slot keeps its index and every edge. It has to: slots
    are addressed **by index**, so removing one would shift
    every index above it and invalidate every neighbor list in
    the graph. And a node is a **bridge** — cut it out and a
    neighborhood nobody deleted becomes unreachable.

    ### `Insert(id, v)` on a live id — an upsert

    Same three steps, then a **brand-new slot** is built for `v`
    with a **fresh random level**. The old slot is never edited
    in place: its *inbound* edges were chosen for the old
    vector, and pruning makes edges asymmetric, so finding them
    all is an O(N·M) scan of the whole graph.

    Unchanged vector → early return, no slot spent. That is the
    WAL-replay path.

    ### What a tombstone costs until compaction

    `cands` (the frontier) admits it — a dead node still bridges.
    `results` never does — a dead node is not an answer. So the
    search **widens** instead of returning fewer than `k` hits:
    1.2× at 25% dead, 1.6× at 50%, 2.5× at 75%. `pruneConnections` demotes
    tombstones so they cannot evict a fresh live edge.

    ### `Compact()` — the only thing that gives the memory back

    Builds a **new** graph over the live vectors and swaps it in
    whole. It cannot renumber the live one: neighbor lists are
    slot indices, so removing a slot invalidates every list in the
    graph at once.

    Out comes exactly the graph you would have built if the dead
    vectors had never existed — fresh RNG from the same seed, live
    vectors in slot order — so it is testable by equality rather
    than by sampling recall.

    **Searches and writes keep running.** The replacement is
    built holding *no* lock on the live graph — ids and stored
    vectors never change once placed. `place` / `tombstone` record
    each id they touch in `dirty`; catch-up rounds set those ids
    in the replacement to their *current* state, then the swap
    takes the write lock. `DB.Compact` holds `writeMu` only for
    the last catch-up and the swap.

    The build tracks **survivors**: 2.61 s at 25% dead against
    0.79 s at 75%, per 5k × 128. Compacting early costs more and
    reclaims less, so the index never self-triggers — callers poll
    `Stats().DeadRatio()`; ~0.5 is the threshold.
  |
}

memory: Memory budget {
  style.fill: "#16290F"
  style.stroke: "#9CCC65"
  style.stroke-width: 2

  body: |md
    ### Per node

    **vector** — `dim × 4 bytes`
    **neighbors** — up to `2M` 8-byte ints on L0 + `M` per upper
    layer; at M=16: up to 256 B on L0, plus slice headers
    (the codec writes them as `uint32`: 662 B/vector on disk
    at 128 dims)

    ### At 768 dims

    3 KiB/vector → **1M vectors ≈ 3 GiB**, graph overhead is minor

    ### At 128 dims

    512 B/vector → the **neighbor lists are the same order as the data**

    Know which regime you are in — it decides whether quantization
    or graph compaction is the optimization that matters.
  |
}

graph_struct -> node_struct: "nodes[i]"
graph_struct -> state_struct: "pool.Get() — one per traversal,\nnever graph-owned" {
  style.stroke: "#9CCC65"
  style.stroke-dash: 3
}
node_struct -> lifecycle: "deleted"
node_struct -> hierarchy: participates on layers 0..topLevel
hierarchy -> selection: edges chosen by

# --- annotations, drawn faint so they never compete with the flow ---
hierarchy -> level_note: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
node_struct -> memory: {
  style.stroke-dash: 4
  style.opacity: 0.7
  style.stroke: "#6E6E6E"
}
